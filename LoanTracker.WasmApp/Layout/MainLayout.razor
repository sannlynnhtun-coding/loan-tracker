@inherits LayoutComponentBase

<div class="min-h-screen flex flex-col md:flex-row bg-premium-50">
    <!-- Sidebar -->
    <aside class="w-full md:w-64 flex-shrink-0 bg-premium-900 text-white md:sticky md:top-0 md:h-screen transition-all duration-300 z-50 shadow-2xl">
        <NavMenu />
    </aside>

    <!-- Main Content -->
    <main class="flex-1 flex flex-col min-w-0 overflow-hidden">
        <!-- Top row / Header -->
        <header class="h-16 flex items-center justify-between px-6 bg-white/80 backdrop-blur-md border-b border-premium-100 sticky top-0 z-40">
            <div class="flex items-center gap-4">
                <span class="text-premium-400 font-medium text-sm hidden md:block">System Status: <span class="text-premium-600 font-bold uppercase tracking-tighter">Operational</span></span>
            </div>
            <div class="flex items-center gap-4">
                <a href="https://learn.microsoft.com/aspnet/core/" target="_blank" class="text-premium-600 hover:text-premium-800 text-sm font-bold transition-colors">Documentation</a>
            </div>
        </header>

        <!-- Page Body -->
        <article class="flex-1 overflow-y-auto p-6 md:p-10">
            @Body
        </article>
    </main>
</div>
