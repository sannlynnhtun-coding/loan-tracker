@page "/loans/apply"
@inject IndexedDbService Db
@inject NavigationManager Navigation

<PageTitle>Originate Loan</PageTitle>

<div class="max-w-3xl mx-auto py-12 px-6">
    <div class="mb-10">
        <button @onclick="@(() => Navigation.NavigateTo("/loans"))" class="text-premium-400 hover:text-premium-600 font-bold text-sm flex items-center gap-2 mb-4 group transition-colors">
            <svg class="w-4 h-4 group-hover:-translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
            Cancel and Return
        </button>
        <h1 class="text-4xl font-black text-premium-900 tracking-tight">Originate Loan</h1>
        <p class="text-premium-600 font-medium">Structure a new credit facility and generate legal schedules.</p>
    </div>

    @if (customers == null || loanTypes == null)
    {
        <div class="py-12 text-center">
            <div class="w-10 h-10 border-4 border-premium-100 border-t-premium-600 rounded-full animate-spin mx-auto mb-4"></div>
            <p class="text-premium-400 font-bold">Loading system entities...</p>
        </div>
    }
    else
    {
        <Card>
            <EditForm Model="request" OnValidSubmit="HandleSubmit" class="space-y-6">
                <DataAnnotationsValidator />

                <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                    <div class="space-y-1">
                        <label class="text-xs font-black uppercase tracking-widest text-premium-500">Target Borrower</label>
                        <InputSelect @bind-Value="request.CustomerId" class="w-full px-4 py-3 bg-premium-50 border border-premium-100 rounded-xl focus:border-premium-500 outline-none font-bold text-premium-900 appearance-none">
                            <option value="0">-- Select Verified Borrower --</option>
                            @foreach (var c in customers)
                            {
                                <option value="@c.CustomerId">@c.CustomerName (@c.Nrc)</option>
                            }
                        </InputSelect>
                    </div>

                    <div class="space-y-1">
                        <label class="text-xs font-black uppercase tracking-widest text-premium-500">Loan Product</label>
                        <InputSelect @bind-Value="request.LoanTypeId" class="w-full px-4 py-3 bg-premium-50 border border-premium-100 rounded-xl focus:border-premium-500 outline-none font-bold text-premium-900 appearance-none">
                            <option value="0">-- Select Product Offering --</option>
                            @foreach (var t in loanTypes)
                            {
                                <option value="@t.LoanTypeId">@t.LoanTypeName</option>
                            }
                        </InputSelect>
                    </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                    <div class="space-y-1">
                        <label class="text-xs font-black uppercase tracking-widest text-premium-500">Principal (MMK)</label>
                        <InputNumber @bind-Value="request.PrincipalAmount" class="w-full px-4 py-3 bg-premium-50 border border-premium-100 rounded-xl focus:border-premium-500 outline-none font-bold text-premium-900" />
                    </div>
                    <div class="space-y-1">
                        <label class="text-xs font-black uppercase tracking-widest text-premium-500">Interest Rate %</label>
                        <InputNumber @bind-Value="request.InterestRate" class="w-full px-4 py-3 bg-premium-50 border border-premium-100 rounded-xl focus:border-premium-500 outline-none font-bold text-premium-900" />
                    </div>
                    <div class="space-y-1">
                        <label class="text-xs font-black uppercase tracking-widest text-premium-500">Term (Months)</label>
                        <InputNumber @bind-Value="request.LoanTerm" class="w-full px-4 py-3 bg-premium-50 border border-premium-100 rounded-xl focus:border-premium-500 outline-none font-bold text-premium-900" />
                    </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6 pt-4 border-t border-premium-50">
                    <div class="space-y-1">
                        <label class="text-xs font-black uppercase tracking-widest text-premium-500">Repayment Mode</label>
                        <InputSelect @bind-Value="request.RepaymentFrequency" class="w-full px-4 py-3 bg-premium-50 border border-premium-100 rounded-xl focus:border-premium-500 outline-none font-bold text-premium-900 appearance-none">
                            <option value="Monthly">Standard Monthly</option>
                            <option value="Bullet">One-time Bullet</option>
                        </InputSelect>
                    </div>
                    <div class="space-y-1">
                        <label class="text-xs font-black uppercase tracking-widest text-premium-500">Disbursement Date</label>
                        <InputDate @bind-Value="request.LoanStartDate" class="w-full px-4 py-3 bg-premium-50 border border-premium-100 rounded-xl focus:border-premium-500 outline-none font-bold text-premium-900" />
                    </div>
                </div>

                <div class="pt-6">
                    <Button Type="submit" IsLoading="isSubmitting" Class="w-full h-14 text-lg shadow-xl shadow-premium-500/20">
                        Authorize Origination & Generate Schedule
                    </Button>
                </div>
            </EditForm>
        </Card>
    }
</div>

@code {
    private CustomerLoanRequest request = new() { LoanStartDate = DateTime.Today, LoanTerm = 12, InterestRate = 12, RepaymentFrequency = "Monthly" };
    private List<CustomerResponse>? customers;
    private List<LoanTypeResponse>? loanTypes;
    private bool isSubmitting = false;

    protected override async Task OnInitializedAsync()
    {
        customers = await Db.GetAllCustomers();
        loanTypes = await Db.GetAllLoanTypes();
    }

    private async Task HandleSubmit()
    {
        if (request.CustomerId == 0 || request.LoanTypeId == 0) return;

        isSubmitting = true;
        try
        {
            await Db.CreateLoan(request);
            Navigation.NavigateTo("/loans");
        }
        finally
        {
            isSubmitting = false;
        }
    }
}
