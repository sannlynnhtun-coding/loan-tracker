@page "/loan-types/create"
@inject IndexedDbService Db
@inject NavigationManager Navigation

<PageTitle>Design Loan Product</PageTitle>

<div class="max-w-2xl mx-auto py-12 px-6">
    <div class="mb-10">
        <button @onclick="@(() => Navigation.NavigateTo("/loan-types"))" class="text-premium-400 hover:text-premium-600 font-bold text-sm flex items-center gap-2 mb-4 group transition-colors">
            <svg class="w-4 h-4 group-hover:-translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
            Back to Catalog
        </button>
        <h1 class="text-4xl font-black text-premium-900 tracking-tight">Design Product</h1>
        <p class="text-premium-600 font-medium">Configure a new credit offering for your borrowers.</p>
    </div>

    <Card>
        <EditForm Model="loanType" OnValidSubmit="HandleSubmit" class="space-y-6">
            <DataAnnotationsValidator />

            <div class="space-y-1">
                <label class="text-xs font-black uppercase tracking-widest text-premium-500">Product Name (English)</label>
                <InputText @bind-Value="loanType.LoanTypeName" placeholder="e.g. Gold Backed Loan" 
                           class="w-full px-4 py-3 bg-premium-50 border border-premium-100 rounded-xl focus:border-premium-500 outline-none transition-all font-bold text-premium-900" />
                <ValidationMessage For="@(() => loanType.LoanTypeName)" class="text-rose-500 text-xs font-bold mt-1" />
            </div>

            <div class="space-y-1">
                <label class="text-xs font-black uppercase tracking-widest text-premium-500">Product Name (Burmese)</label>
                <InputText @bind-Value="loanType.BurmeseLoanTypeName" placeholder="e.g. ရွှေပေါင်နှံချေးငွေ" 
                           class="w-full px-4 py-3 bg-premium-50 border border-premium-100 rounded-xl focus:border-premium-500 outline-none transition-all font-bold text-premium-900" />
            </div>

            <div class="space-y-1">
                <label class="text-xs font-black uppercase tracking-widest text-premium-500">Detailed Description</label>
                <InputTextArea @bind-Value="loanType.Description" rows="4" placeholder="Explain the terms and conditions..." 
                               class="w-full px-4 py-3 bg-premium-50 border border-premium-100 rounded-xl focus:border-premium-500 outline-none transition-all font-medium text-premium-900 resize-none" />
            </div>

            <div class="pt-4">
                <Button Type="submit" IsLoading="isSubmitting" Class="w-full h-14 text-lg shadow-xl shadow-premium-500/20">
                    Publish Product Offering
                </Button>
            </div>
        </EditForm>
    </Card>
</div>

@code {
    private LoanTypeResponse loanType = new();
    private bool isSubmitting = false;

    private async Task HandleSubmit()
    {
        isSubmitting = true;
        try
        {
            await Db.AddLoanType(loanType);
            Navigation.NavigateTo("/loan-types");
        }
        finally
        {
            isSubmitting = false;
        }
    }
}
