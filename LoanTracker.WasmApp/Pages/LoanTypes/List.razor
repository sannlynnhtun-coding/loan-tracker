@page "/loan-types"
@inject IndexedDbService Db
@inject NavigationManager Navigation

<PageTitle>Loan Products</PageTitle>

<div class="max-w-6xl mx-auto py-10 px-6">
    <div class="flex flex-col md:flex-row justify-between items-start md:items-center mb-10 gap-6">
        <div>
            <h1 class="text-4xl font-black text-premium-900 tracking-tight">Loan Products</h1>
            <p class="text-premium-600 font-medium mt-1">Configure your credit portfolio offerings.</p>
        </div>
        <Button OnClick="@(() => Navigation.NavigateTo("/loan-types/create"))" Class="shadow-xl">
            <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path></svg>
            Design New Product
        </Button>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        @if (loanTypes == null || !loanTypes.Any())
        {
            <div class="col-span-full py-24 text-center bg-white rounded-3xl border border-premium-100 border-dashed">
                <div class="w-16 h-16 bg-premium-50 rounded-full mx-auto flex items-center justify-center text-premium-200 mb-4">
                    <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path></svg>
                </div>
                <p class="text-premium-400 font-black uppercase tracking-widest text-sm">No products configured</p>
            </div>
        }
        else
        {
            @foreach (var type in loanTypes)
            {
                <Card Class="relative group hover:-translate-y-2 transition-all duration-300">
                    <div class="absolute top-4 right-4 flex gap-2 opacity-0 group-hover:opacity-100 transition-opacity">
                        <button class="p-2 bg-white shadow-sm border border-premium-50 rounded-lg text-premium-400 hover:text-premium-600">
                             <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"></path></svg>
                        </button>
                        <button @onclick="() => OnDelete(type.LoanTypeId)" class="p-2 bg-white shadow-sm border border-rose-50 rounded-lg text-rose-300 hover:text-rose-600">
                             <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
                        </button>
                    </div>

                    <div class="mb-6">
                        <h3 class="text-xl font-black text-premium-900">@type.LoanTypeName</h3>
                        @if (!string.IsNullOrEmpty(type.BurmeseLoanTypeName))
                        {
                            <p class="text-premium-600 font-bold text-sm mt-1">@type.BurmeseLoanTypeName</p>
                        }
                    </div>

                    <p class="text-premium-500 text-sm font-medium line-clamp-3 mb-8 italic">
                        @(string.IsNullOrEmpty(type.Description) ? "No description provided for this product offering." : type.Description)
                    </p>

                    <div class="pt-4 border-t border-premium-50 flex justify-between items-center">
                        <span class="text-[10px] font-black uppercase tracking-widest text-premium-400">Security: Verified</span>
                        <div class="w-6 h-6 rounded-full bg-premium-100 flex items-center justify-center text-premium-600">
                            <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M2.166 4.999A11.954 11.954 0 0010 1.944 11.954 11.954 0 0017.834 5c.11.65.166 1.32.166 2.001 0 5.225-3.34 9.67-8 11.317C5.34 16.67 2 12.225 2 7c0-.682.057-1.35.166-2.001zm11.541 3.708a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path></svg>
                        </div>
                    </div>
                </Card>
            }
        }
    </div>
</div>

@code {
    private List<LoanTypeResponse>? loanTypes;

    protected override async Task OnInitializedAsync()
    {
        await LoadLoanTypes();
    }

    private async Task LoadLoanTypes()
    {
        loanTypes = await Db.GetAllLoanTypes();
    }

    private async Task OnDelete(int id)
    {
        await Db.DeleteLoanType(id);
        await LoadLoanTypes();
    }
}
